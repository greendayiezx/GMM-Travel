# ══════════════════════════════════════════════════════════════════
#  .env.production.example — TEMPLATE DEPLOYMENT GMM Global Explore
# ──────────────────────────────────────────────────────────────────
#  Cara pakai di server production:
#    1. cp .env.production.example .env
#    2. Isi semua nilai bertanda  << GANTI >>
#    3. php artisan key:generate           (isi APP_KEY)
#    4. php artisan migrate --force
#    5. php artisan db:seed --class=PackageCatalogSeeder --force
#    6. php artisan storage:link
#    7. php artisan config:cache && php artisan route:cache
#    8. php artisan data:clean-dummy       (hapus data dummy)
#
#  JANGAN commit file .env asli ke git. File ini hanya template (tanpa rahasia).
# ══════════════════════════════════════════════════════════════════

# ── Aplikasi ──────────────────────────────────────────────────────
APP_NAME="GMM Global Explore"
APP_ENV=production
APP_KEY=                                   # << GANTI >> jalankan: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.gmmglobalexplore.com   # << GANTI >> domain backend asli

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database ──────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1                          # << GANTI >> host DB production
DB_PORT=3306
DB_DATABASE=gmm_travel                     # << GANTI >>
DB_USERNAME=                               # << GANTI >>
DB_PASSWORD=                               # << GANTI >> password kuat

# ── Cache / Queue / Session ───────────────────────────────────────
CACHE_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DISK=local
# Queue: pakai database agar email welcome tidak memblokir request.
# Setelah deploy, jalankan worker: php artisan queue:work --tries=3
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
# WAJIB true di production (butuh HTTPS) — cookie hanya lewat koneksi aman.
SESSION_SECURE_COOKIE=true

# ── Midtrans (PAYMENT) ────────────────────────────────────────────
# WAJIB production keys + IS_PRODUCTION=true. Aktifkan Core API channel di
# dashboard Midtrans (bank_transfer / echannel / qris) sebelum go-live.
MIDTRANS_SERVER_KEY=                        # << GANTI >> Mid-server-...
MIDTRANS_CLIENT_KEY=                        # << GANTI >> Mid-client-...
MIDTRANS_IS_PRODUCTION=true

# ── Flight Search ─────────────────────────────────────────────────
TRAVELPAYOUTS_TOKEN=                        # << GANTI >>
TRAVELPAYOUTS_MARKER=                       # (opsional) partner marker
DUFFEL_TOKEN=                               # << GANTI >> token Duffel LIVE (bukan test)
DUFFEL_VERSION=v2

# ── Clerk (AUTH) ──────────────────────────────────────────────────
# WAJIB production instance (dev keys punya usage limit ketat).
CLERK_SECRET_KEY=                           # << GANTI >> sk_live_...
CLERK_PUBLISHABLE_KEY=                      # << GANTI >> pk_live_...
# JWKS production: https://<frontend-api-production>/.well-known/jwks.json
CLERK_JWKS_URL=                             # << GANTI >>
# Signing secret webhook production (Clerk Dashboard → Webhooks).
CLERK_WEBHOOK_SECRET=                       # << GANTI >> whsec_...
# JANGAN lupa: ganti PUBLISHABLE_KEY juga di frontend clerk.service.ts

# ── Keamanan ──────────────────────────────────────────────────────
# Generate BARU untuk production (jangan pakai nilai development):
#   php -r "echo bin2hex(random_bytes(32));"
ORDER_HASH_SECRET=                          # << GANTI >> 64 hex chars
# Ganti ke nilai random kuat (bukan 'gmm-staff-2026').
STAFF_PANEL_KEY=                            # << GANTI >>

# ── Email (SMTP) ──────────────────────────────────────────────────
# Idealnya email domain perusahaan (Google Workspace / Zoho). App Password
# untuk Gmail; JANGAN password akun biasa.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com                    # << GANTI bila pakai provider lain >>
MAIL_PORT=587
MAIL_USERNAME=                              # << GANTI >> email pengirim
MAIL_PASSWORD=                              # << GANTI >> app password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=                          # << GANTI >> no-reply@gmmglobalexplore.com
MAIL_FROM_NAME="GMM Global Explore"

# ── Frontend / CORS ───────────────────────────────────────────────
FRONTEND_URL=https://gmmglobalexplore.com  # << GANTI >> domain frontend asli
# Domain yang boleh akses API (pisah koma bila lebih dari satu).
CORS_ALLOWED_ORIGINS=https://gmmglobalexplore.com,https://www.gmmglobalexplore.com

# ── Bisnis ────────────────────────────────────────────────────────
# Floor amount paket (fallback bila paket di luar katalog). Sesuaikan.
PACKAGE_MIN_AMOUNT=50000
